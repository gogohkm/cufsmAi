{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stcfsd-records-schema/1",
  "title": "StCFSD records (R1 - R5) — design-stage schema",
  "description": "Companion of docs/implementation/20261124-records-design.md. Design only: names and limits are the proposal; the implementation may tighten them. Every log line = envelope + the fields of its type. Readers drop unknown keys (same major) and skip unknown events; a higher major makes that record type read-only.",
  "$defs": {
    "fp": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "fp(ns, v) = 'sha256:' + hex(sha256(canonicalJSON({ns, v}))). Canonical JSON: sorted keys, no whitespace, JS number form, no NaN/Infinity." },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" },
    "caseId": { "type": "string", "pattern": "^c[a-z2-7]{16}$" },
    "projectId": { "type": "string", "pattern": "^p[a-z2-7]{16}$" },
    "writerId": { "type": "string", "pattern": "^w[a-z2-7]{20}$" },
    "relPath": { "type": "string", "maxLength": 400, "description": "Project-relative, '/' separators, NFC, no '..', no ':', no leading '/', no drive letter. Resolved with link/junction refusal." },
    "isoTime": { "type": "string", "format": "date-time", "description": "Host clock, with offset." },
    "aiText": { "type": "string", "description": "Plain text written by an AI session. Control characters other than \\n and \\t are removed; over-limit text is refused, never truncated." },
    "actor": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["ai", "person", "screen", "program", "file", "external"] },
        "client": { "type": "string", "maxLength": 80, "description": "MCP clientInfo name/version (ai only)" },
        "request": { "type": "string", "maxLength": 80, "description": "X-StCFSD-Request-Id (ai only)" },
        "tool": { "type": "string", "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "sig": {
      "type": "object",
      "required": ["w", "s"],
      "properties": {
        "w": { "$ref": "#/$defs/writerId" },
        "s": { "type": "string", "maxLength": 128, "description": "Ed25519 over 'stcfsd-rec-sig/1\\n' + canonicalJSON(line without sig), base64" }
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": ["schema", "seq", "id", "event", "at", "project", "actor", "prev", "sig"],
      "properties": {
        "schema": { "type": "string", "pattern": "^stcfsd-rec/(cases|changes|runs|work|assumptions|sources|reviews|alternatives|documents)/[0-9]+$" },
        "seq": { "type": "integer", "minimum": 1 },
        "id": { "$ref": "#/$defs/recId" },
        "event": { "type": "string", "maxLength": 32 },
        "at": { "$ref": "#/$defs/isoTime" },
        "project": { "$ref": "#/$defs/projectId" },
        "actor": { "$ref": "#/$defs/actor" },
        "prev": { "oneOf": [{ "$ref": "#/$defs/fp" }, { "type": "null" }], "description": "Hash of the previous line's bytes in the same stream file (null for the first line of the first segment)." },
        "sig": { "$ref": "#/$defs/sig" }
      },
      "x-limits": { "lineBytes": 65536, "streamSegmentBytes": 8388608, "streamReadBytes": 33554432, "projectReadBytes": 268435456 }
    },
    "checkTarget": {
      "type": "object",
      "required": ["scope", "id"],
      "properties": {
        "scope": { "enum": ["member", "purlin", "connection", "lap"] },
        "id": { "type": "string", "maxLength": 200, "description": "design_checks id (python/design/checks.py REGISTRY)" },
        "location": { "description": "design_checks[].location as given by the engine/host (US values)" },
        "combination": { "type": ["string", "null"], "maxLength": 200 },
        "key": { "type": "string", "maxLength": 600, "description": "<scope>|<id>|<fp(location)>|<combination or ''>" }
      }
    },
    "ref": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["check", "field", "result", "change", "assumption", "source", "case", "work", "alternative", "document"] },
        "caseId": { "$ref": "#/$defs/caseId" },
        "check": { "$ref": "#/$defs/checkTarget" },
        "path": { "type": "string", "maxLength": 200, "description": "field path, e.g. case.inputs.fy, model.section_params.t" },
        "result": { "enum": ["buckling_analysis", "signature_ss", "design_dsm", "load_analysis", "member_design", "connection", "lap", "plastic_surface", "vibration", "validation"] },
        "id": { "$ref": "#/$defs/recId" }
      }
    },
    "contentBasis": {
      "type": "object",
      "properties": {
        "contentFp": { "$ref": "#/$defs/fp" },
        "modelFp": { "$ref": "#/$defs/fp" },
        "caseFp": { "$ref": "#/$defs/fp" }
      }
    },
    "fileEntry": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/relPath" },
        "sha256": { "$ref": "#/$defs/sha" },
        "size": { "type": "integer", "minimum": 0 },
        "role": { "enum": ["document", "case", "record", "manifest"] }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["name", "writerId"],
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "writerId": { "$ref": "#/$defs/writerId" }
      }
    }
  },

  "x-files": {
    "declaration": {
      "file": "stcfsd-project.json",
      "type": "object",
      "required": ["schema", "projectId", "name", "createdAt", "createdBy"],
      "properties": {
        "schema": { "const": "stcfsd-project/1" },
        "projectId": { "$ref": "#/$defs/projectId" },
        "name": { "type": "string", "maxLength": 60 },
        "createdAt": { "$ref": "#/$defs/isoTime" },
        "createdBy": { "type": "object", "properties": { "app": { "const": "StCFSD" }, "version": { "type": "string", "maxLength": 40 } } }
      },
      "x-rules": ["regular file, <= 16 KB", "written once, never rewritten", "folder names are program constants and are NOT read from here"]
    },
    "writer": {
      "file": ".stcfsd/writers/<writerId>.json",
      "required": ["schema", "writerId", "publicKey", "name", "host", "createdAt", "sig"],
      "properties": {
        "schema": { "const": "stcfsd-writer/1" },
        "writerId": { "$ref": "#/$defs/writerId" },
        "publicKey": { "type": "string", "maxLength": 200, "description": "Ed25519 SPKI DER, base64" },
        "name": { "type": "string", "maxLength": 60 },
        "host": { "type": "string", "maxLength": 64 },
        "createdAt": { "$ref": "#/$defs/isoTime" },
        "sig": { "$ref": "#/$defs/sig" }
      },
      "x-rules": ["trust lives only in %LOCALAPPDATA%\\StCFSD\\records\\trust.json; own key trusted, others only after the person clicks 'trust'"]
    },
    "csdAddition": {
      "file": "02_검토대상/<name>.csd",
      "description": ".csd 1.4 unchanged except one optional top-level key; version stays 1.4 (1.4 builds ignore and drop unknown top-level keys).",
      "properties": { "record": { "type": "object", "properties": { "caseId": { "$ref": "#/$defs/caseId" }, "projectId": { "$ref": "#/$defs/projectId" } }, "additionalProperties": false } }
    },
    "index": {
      "file": ".stcfsd/index/<caseId>.json",
      "description": "Unsigned derived cache for the start screen. Valid only while csdSha matches the .csd on disk; otherwise rebuilt from the .csd (<= 20 MB).",
      "properties": {
        "schema": { "const": "stcfsd-index/1" },
        "caseId": { "$ref": "#/$defs/caseId" },
        "csdSha": { "$ref": "#/$defs/sha" },
        "name": { "type": "string", "maxLength": 60 },
        "kind": { "type": "string", "maxLength": 40 },
        "section": { "type": "object", "properties": { "template": { "type": ["string", "null"] }, "params": { "type": "object" }, "node": { "type": "array", "maxItems": 2000 }, "elem": { "type": "array", "maxItems": 2000 } } },
        "material": { "type": ["string", "null"], "maxLength": 40 },
        "maxRatio": { "type": ["number", "null"] },
        "results": { "type": "object", "description": "kind -> 'current' | 'stale' | 'none' | 'other-engine'" },
        "lastActivity": { "type": "object", "properties": { "at": { "$ref": "#/$defs/isoTime" }, "actor": { "enum": ["ai", "person", "program", "file", "external"] } } },
        "openQuestions": { "type": "integer", "minimum": 0 },
        "lastIssue": { "type": ["string", "null"], "maxLength": 8 }
      }
    },
    "lock": {
      "file": ".stcfsd/locks/<caseId>.lock",
      "properties": { "writerId": { "$ref": "#/$defs/writerId" }, "name": { "type": "string", "maxLength": 60 }, "host": { "type": "string", "maxLength": 64 }, "pid": { "type": "integer" }, "at": { "$ref": "#/$defs/isoTime" } },
      "x-rules": ["created with wx", "advisory: never blocks review marks or issue", "same-host dead pid -> removed; other-host > 12 h -> person may take over"]
    },
    "manifest": {
      "file": "04_발행본/<case name>/R<n>/manifest.json",
      "required": ["schema", "project", "case", "revision", "label", "issuedAt", "issuedBy", "engineId", "contentFp", "runs", "files", "check"],
      "properties": {
        "schema": { "const": "stcfsd-issue/1" },
        "project": { "type": "object", "properties": { "name": { "type": "string" }, "projectId": { "$ref": "#/$defs/projectId" } } },
        "case": { "type": "object", "properties": { "caseId": { "$ref": "#/$defs/caseId" }, "name": { "type": "string" } } },
        "revision": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "pattern": "^R[0-9]{1,3}$" },
        "issuedAt": { "$ref": "#/$defs/isoTime" },
        "issuedBy": { "$ref": "#/$defs/reviewer" },
        "engineId": { "$ref": "#/$defs/fp" },
        "contentFp": { "$ref": "#/$defs/fp" },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/recId" } },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileEntry" } },
        "check": { "type": "object", "properties": { "fingerprint": { "$ref": "#/$defs/fp" }, "warnings": { "type": "array" }, "passed": { "type": "array" } } }
      },
      "x-rules": ["folder created exclusively (mkdir, no recursive into an existing R<n>)", "every file written with flag wx", "manifest written last", "its sha256 is in the signed issue line"]
    }
  },

  "x-lines": {
    "cases": {
      "schema": "stcfsd-rec/cases/1",
      "events": ["create", "import", "discovered", "relink", "opened", "saved", "external", "archive", "unarchive"],
      "writers": { "program": ["discovered", "opened", "saved", "external"], "ai": ["create", "import"], "person": ["create", "import", "relink", "archive", "unarchive"] },
      "fields": {
        "caseId": { "$ref": "#/$defs/caseId" },
        "name": { "type": "string", "maxLength": 60 },
        "file": { "$ref": "#/$defs/relPath" },
        "kind": { "enum": ["roof-purlin", "wall-girt", "floor-joist", "wall-stud", "flexure", "compression", "combined", "tension", "section-only"] },
        "fileSha": { "$ref": "#/$defs/sha" },
        "contentFp": { "$ref": "#/$defs/fp" },
        "bytes": { "type": "integer" },
        "origin": { "type": "object", "properties": { "name": { "type": "string", "maxLength": 260 }, "sha256": { "$ref": "#/$defs/sha" } }, "description": "import only — original file name (not path) and hash" },
        "snapshot": { "$ref": "#/$defs/sha", "description": "saved: blob of model + case at save (enables 'external' diffs)" }
      }
    },
    "runs": {
      "schema": "stcfsd-rec/runs/1",
      "events": ["run", "prune"],
      "writers": { "program": ["run", "prune"] },
      "fields": {
        "caseId": { "$ref": "#/$defs/caseId" },
        "kind": { "enum": ["buckling_analysis", "signature_ss", "design_dsm", "load_analysis", "member_design", "connection", "lap", "plastic_surface", "vibration", "validation"] },
        "engineId": { "$ref": "#/$defs/fp" },
        "modelFp": { "$ref": "#/$defs/fp" },
        "caseFp": { "$ref": "#/$defs/fp" },
        "requestFp": { "$ref": "#/$defs/fp" },
        "resultFp": { "$ref": "#/$defs/fp" },
        "blob": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "snapshot": { "$ref": "#/$defs/sha" },
        "caseRev": { "type": "integer" },
        "ms": { "type": "integer" },
        "status": { "enum": ["ok", "failed"] },
        "error": { "type": "string", "maxLength": 300 },
        "summary": { "type": "object", "description": "<= 4 KB: verdict, max_ratio, governing [{id, ratio, verdict, location?}], counts — copied from engine output, never computed" },
        "pruned": { "type": "array", "items": { "$ref": "#/$defs/sha" }, "description": "prune only" }
      }
    },
    "changes": {
      "schema": "stcfsd-rec/changes/1",
      "events": ["change"],
      "writers": { "program": ["change"] },
      "fields": {
        "caseId": { "$ref": "#/$defs/caseId" },
        "trigger": { "type": "string", "maxLength": 80, "description": "tool/action name, 'edit-session', 'open', 'import', 'restore-alternative', 'external'" },
        "reason": { "$ref": "#/$defs/aiText", "maxLength": 300 },
        "work": { "$ref": "#/$defs/recId" },
        "source": { "$ref": "#/$defs/recId" },
        "before": { "$ref": "#/$defs/contentBasis" },
        "after": { "$ref": "#/$defs/contentBasis" },
        "fields": {
          "type": "array", "maxItems": 200,
          "items": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string", "maxLength": 200 }, "group": { "type": "string", "maxLength": 40 }, "unit": { "type": "string", "maxLength": 40, "description": "unit kind (siUnits.CASE_UNIT_KIND or model field unit); values are US" }, "from": {}, "to": {}, "summary": { "type": "object", "description": "arrays (node/elem/lengths): counts and changed indices (<= 200)" } } }
        },
        "follows": { "type": "array", "maxItems": 60, "items": { "type": "object", "properties": { "path": { "type": "string" }, "from": {}, "to": {}, "by": { "enum": ["load-analysis", "mirror"] } } } },
        "invalidated": { "type": "array", "items": { "type": "object", "properties": { "kind": { "type": "string" }, "id": { "type": "string" }, "reason": { "type": "string", "maxLength": 300 } } } },
        "title": { "type": "string", "maxLength": 160, "description": "generated by the program from fields — not AI text" },
        "snapshotAfter": { "$ref": "#/$defs/sha" }
      }
    },
    "work": {
      "schema": "stcfsd-rec/work/1",
      "events": ["add", "answer", "update", "close", "reopen"],
      "writers": { "ai": ["add", "answer", "update", "close", "reopen"] },
      "fields": {
        "item": { "$ref": "#/$defs/recId", "description": "I-n | R-n | Q-n" },
        "kind": { "enum": ["instruction", "report", "question"] },
        "caseId": { "oneOf": [{ "$ref": "#/$defs/caseId" }, { "type": "null" }] },
        "title": { "$ref": "#/$defs/aiText", "maxLength": 120 },
        "body": { "$ref": "#/$defs/aiText", "maxLength": 8000 },
        "items": { "type": "array", "maxItems": 50, "items": { "type": "object", "properties": { "text": { "$ref": "#/$defs/aiText", "maxLength": 300 }, "status": { "enum": ["done", "assumed", "open"] }, "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } } } } },
        "options": { "type": "array", "maxItems": 8, "items": { "type": "object", "properties": { "label": { "$ref": "#/$defs/aiText", "maxLength": 120 }, "consequence": { "$ref": "#/$defs/aiText", "maxLength": 600 } } } },
        "refs": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/ref" } },
        "answer": { "type": "object", "properties": { "said": { "$ref": "#/$defs/aiText", "maxLength": 4000, "description": "the person's words as transcribed by the AI — shown as 'AI 가 옮겨 적음'" }, "chosen": { "type": ["integer", "null"] } } },
        "basis": { "type": "object", "properties": { "contentFp": { "$ref": "#/$defs/fp" }, "runs": { "type": "array", "items": { "$ref": "#/$defs/recId" } } } }
      }
    },
    "assumptions": {
      "schema": "stcfsd-rec/assumptions/1",
      "events": ["add", "update", "close"],
      "writers": { "ai": ["add", "update", "close"], "program": ["add", "close"] },
      "fields": {
        "item": { "type": "string", "pattern": "^A-[0-9]{2,4}$" },
        "caseId": { "oneOf": [{ "$ref": "#/$defs/caseId" }, { "type": "null" }] },
        "text": { "$ref": "#/$defs/aiText", "maxLength": 300 },
        "basis": { "$ref": "#/$defs/aiText", "maxLength": 2000 },
        "status": { "enum": ["provisional", "firm", "field-check", "not-applicable"] },
        "scope": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/ref" } },
        "sources": { "type": "array", "maxItems": 10, "items": { "type": "object", "properties": { "id": { "$ref": "#/$defs/recId" }, "page": { "type": "string", "maxLength": 20 }, "area": { "type": "string", "maxLength": 80 } } } },
        "impact": { "$ref": "#/$defs/aiText", "maxLength": 600 },
        "origin": { "enum": ["ai", "program-default", "program-engine"] },
        "originKey": { "type": "string", "maxLength": 120, "description": "program-default: FIELDS group; program-engine: result kind + note code (or text hash until K4b codes exist)" },
        "closedBy": { "$ref": "#/$defs/recId", "description": "change id that set the value (program close)" }
      }
    },
    "sources": {
      "schema": "stcfsd-rec/sources/1",
      "events": ["register", "update"],
      "writers": { "ai": ["register", "update"] },
      "fields": {
        "item": { "type": "string", "pattern": "^S-[0-9]{1,4}$" },
        "path": { "$ref": "#/$defs/relPath", "description": "must start with '01_원자료/'" },
        "sha256": { "$ref": "#/$defs/sha" },
        "size": { "type": "integer", "maximum": 536870912 },
        "title": { "$ref": "#/$defs/aiText", "maxLength": 120 },
        "kind": { "enum": ["drawing", "product", "other"] }
      }
    },
    "reviews": {
      "schema": "stcfsd-rec/reviews/1",
      "events": ["mark", "unmark"],
      "writers": { "person": ["mark", "unmark"] },
      "fields": {
        "via": { "const": "person" },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "engineId": { "$ref": "#/$defs/fp" },
        "targets": {
          "type": "array", "minItems": 1, "maxItems": 200,
          "items": {
            "type": "object", "required": ["kind"],
            "properties": {
              "kind": { "enum": ["check", "result", "group", "change", "work", "assumption"] },
              "caseId": { "$ref": "#/$defs/caseId" },
              "check": { "$ref": "#/$defs/checkTarget" },
              "checkFp": { "$ref": "#/$defs/fp" },
              "result": { "type": "string" },
              "resultFp": { "$ref": "#/$defs/fp" },
              "group": { "type": "string", "maxLength": 40 },
              "groupFp": { "$ref": "#/$defs/fp" },
              "changeId": { "$ref": "#/$defs/recId" },
              "item": { "$ref": "#/$defs/recId" },
              "itemSeq": { "type": "integer" },
              "runId": { "$ref": "#/$defs/recId" },
              "verdict": { "enum": ["pass", "fail", "not_evaluated", "not_applicable"] },
              "ratio": { "type": ["number", "null"] }
            }
          }
        }
      },
      "x-validity": "check: current non-invalidated result has same key and same checkFp; result: same resultFp; group: same groupFp; change: always; work/assumption: same last seq. Computed on read — the program never writes review lines. Lines whose signature does not verify against a trusted writer are not counted."
    },
    "alternatives": {
      "schema": "stcfsd-rec/alternatives/1",
      "events": ["keep", "rename", "drop", "undrop"],
      "writers": { "ai": ["keep", "rename", "drop", "undrop"] },
      "fields": {
        "item": { "type": "string", "pattern": "^ALT-[0-9]{1,4}$" },
        "caseId": { "$ref": "#/$defs/caseId" },
        "label": { "$ref": "#/$defs/aiText", "maxLength": 80 },
        "contentFp": { "$ref": "#/$defs/fp" },
        "snapshot": { "$ref": "#/$defs/sha" },
        "runs": { "type": "object", "description": "result kind -> run id" },
        "diff": { "type": "array", "maxItems": 200, "description": "same item shape as changes.fields — generated by the program" }
      }
    },
    "documents": {
      "schema": "stcfsd-rec/documents/1",
      "events": ["draft", "export", "issue", "issue-failed"],
      "writers": { "ai": ["draft"], "person": ["draft", "export", "issue"], "program": ["issue-failed"] },
      "fields": {
        "item": { "$ref": "#/$defs/recId", "description": "D-n for drafts, R<n> for issues" },
        "caseId": { "$ref": "#/$defs/caseId" },
        "kind": { "enum": ["calc", "buckling", "validation"] },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileEntry" } },
        "docFp": { "$ref": "#/$defs/fp" },
        "doc": { "$ref": "#/$defs/sha", "description": "ReportDoc blob" },
        "basis": { "type": "object", "properties": { "contentFp": { "$ref": "#/$defs/fp" }, "engineId": { "$ref": "#/$defs/fp" }, "runs": { "type": "array", "items": { "$ref": "#/$defs/recId" } }, "registerFp": { "$ref": "#/$defs/fp" } } },
        "stamp": { "type": "object", "properties": { "kind": { "enum": ["draft", "issued"] }, "label": { "type": "string" }, "notChecked": { "type": "integer" }, "reviewer": { "type": "string", "maxLength": 60 }, "date": { "type": "string" } } },
        "revision": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "pattern": "^R[0-9]{1,3}$" },
        "folder": { "$ref": "#/$defs/relPath" },
        "manifest": { "type": "object", "properties": { "sha256": { "$ref": "#/$defs/sha" }, "size": { "type": "integer" } } },
        "check": { "type": "object", "properties": { "fingerprint": { "$ref": "#/$defs/fp" }, "warnings": { "type": "array" } } },
        "issuedBy": { "$ref": "#/$defs/reviewer" },
        "from": { "$ref": "#/$defs/recId", "description": "draft id the issue was rendered from" }
      }
    }
  },

  "x-mcpTools": {
    "description": "New MCP tools (65 -> 79). None of them can mark reviews or issue. Replies: summary by default; byte budgets enforced by test/webview/mcp_si_chain.js.",
    "tools": [
      { "name": "get_case_status", "stage": "R1", "budgetBytes": 6144 },
      { "name": "list_projects", "stage": "R1", "budgetBytes": 8192 },
      { "name": "open_project", "stage": "R1", "budgetBytes": 6144 },
      { "name": "list_cases", "stage": "R1", "budgetBytes": 8192 },
      { "name": "open_case", "stage": "R1", "budgetBytes": 6144 },
      { "name": "new_case", "stage": "R1", "budgetBytes": 2048 },
